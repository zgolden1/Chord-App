# Database: SQLite file (free, fine for testing) or a PostgreSQL URL from Supabase/Neon (free tier)
DATABASE_URL=sqlite:///chordflow.db
# Contact for MusicBrainz's User-Agent (they ask for one)
MB_CONTACT=you@example.com
# Sign-in: copy "JWT secret" from Supabase > Project Settings > API. Moderators get app_metadata.role = "moderator".
SUPABASE_JWT_SECRET=
# Long random string for the analysis worker / publish script
WORKER_TOKEN=
# Only for local testing. Never set on a public server.
DEV_AUTH=0
CORS_ORIGINS=*
MAX_UPLOAD_MB=60
# 0 = moderators approve everything. N>0: auto-approve when N users agree AND an independent analysis agrees.
AUTO_APPROVE_MIN_AGREE=0

# Free key from Google Cloud Console > APIs & Services > YouTube Data API v3. Used only by the server; never put it in the page.
YOUTUBE_API_KEY=
